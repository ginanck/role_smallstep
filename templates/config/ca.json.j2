{
  "root": "{{ smallstep_ca_certs_dir }}/root_ca.crt",
  "federatedRoots": null,
  "crt": "{{ smallstep_ca_certs_dir }}/intermediate_ca.crt",
  "key": "{{ smallstep_ca_secrets_dir }}/intermediate_ca_key",
  "address": ":{{ smallstep_ca_port }}",
  "dnsNames": [
    "{{ smallstep_ca_dns }}"
  ],
  "logger": {
    "format": "text"
  },
  "db": {
    "type": "badgerv2",
    "dataSource": "{{ smallstep_ca_db_dir }}"
  },
  "authority": {
    "provisioners": [
      {
        "type": "JWK",
        "name": "{{ smallstep_ca_provisioner }}",
        "key": {{ smallstep_provisioner_key | to_json }},
        "encryptedKey": {{ smallstep_provisioner_encrypted_key | to_json }},
        "claims": {
          "maxTLSCertDuration": "{{ smallstep_max_tls_cert_duration }}",
          "defaultTLSCertDuration": "{{ smallstep_default_tls_cert_duration }}"
        }
      }{% if smallstep_acme_enabled | bool %},
      {
        "type": "ACME",
        "name": "{{ smallstep_acme_provisioner_name }}",
        "requireEAB": {{ smallstep_acme_require_eab | bool | to_json }},
        "claims": {
          "maxTLSCertDuration": "{{ smallstep_max_tls_cert_duration }}",
          "defaultTLSCertDuration": "{{ smallstep_default_tls_cert_duration }}"
        }
      }{% endif %}
    ]
  },
  "tls": {
    "cipherSuites": [
      "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
      "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
    ],
    "minVersion": 1.2,
    "maxVersion": 1.3,
    "renegotiation": false
  }
}
