# {{ ansible_managed }}
[Unit]
Description=Smallstep Certificate Authority
Documentation=https://smallstep.com/docs/step-ca
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ smallstep_service_user }}
Group={{ smallstep_service_group }}
Environment=STEPPATH={{ smallstep_ca_dir }}
WorkingDirectory={{ smallstep_ca_dir }}
ExecStart={{ smallstep_bin_dir }}/bin/step-ca {{ smallstep_ca_config_dir }}/ca.json --password-file {{ smallstep_ca_password_file }}
Restart=on-failure
RestartSec=5s
UMask=0077

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths={{ smallstep_ca_dir }}

[Install]
WantedBy=multi-user.target
